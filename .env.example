# 이 파일을 복사해서 .env.development / .env.production 을 만드세요.
#   cp .env.example .env.development
#
# .env* 는 .gitignore 대상이라 저장소에 올라가지 않습니다.
# 배포 환경(Vercel 등)에서는 파일이 아니라 Environment Variables에 같은 값을 등록해야 하며,
# 등록 후 반드시 재배포해야 반영됩니다 (Vite가 빌드 시점에 값을 코드에 새겨 넣기 때문).

# API 서버 주소 — /api/v1 까지 포함해야 합니다. 빠지면 모든 요청이 실패합니다.
VITE_API_BASE_URL=

# 구글 로그인 OAuth 클라이언트 ID (GCP 콘솔 > 사용자 인증 정보).
# CLIENT_SECRET은 백엔드 전용이라 프론트에 두지 않습니다 —
# 프론트는 인가 코드까지만 받아 백엔드로 넘기고, 토큰 교환은 백엔드가 합니다.
VITE_GOOGLE_CLIENT_ID=
